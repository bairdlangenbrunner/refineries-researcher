# Raw source downloads — recipe is committed (manifests), bytes are not
data/*.xlsx
data/*.csv
data/*.gpkg
data/*.geojson
data/*.pdf
sources/**/data/
sources/**/canonical.parquet
# stray source PDFs at the sources/ root (the OGJ survey is proprietary; its home is the
# sibling refineries-tracker repo per sources/ogj/manifest.yml)
sources/*.pdf
# but keep the audit summaries:
!sources/**/canonical_summary.json

# Main (large; regenerated) — decide per-repo whether to commit a snapshot
data/main_*.parquet

# Batch deliverables + staging derived artifacts (agent-authored staging JSON IS committed)
batches/*.xlsx
batches/_archive/
batches/staging/**/*.parquet
batches/staging/**/derived/

# Env / secrets
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
build/
dist/
*.egg-info/

# OS
.DS_Store
data/main_*.json

# codegraph local index
.codegraph/
